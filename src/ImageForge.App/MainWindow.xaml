<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ImageForge.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="ImageForge">
  <ScrollViewer>
    <StackPanel Margin="24" Spacing="12" MaxWidth="900" HorizontalAlignment="Left">
      <TextBlock Text="ImageForge" Style="{StaticResource TitleTextBlockStyle}" />

      <TextBox Header="Источник (папка дистрибутива, например C:\IF\fixture\media)" Text="{x:Bind ViewModel.SourcePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
      <TextBox Header="Рабочая папка (например C:\IF\ws)" Text="{x:Bind ViewModel.WorkPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
      <TextBox Header="Папка результата (например C:\IF\result)" Text="{x:Bind ViewModel.OutputPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
      <TextBlock Text="Цель: образ 1 в sources\install.wim" />

      <TextBlock Text="Реестр" Style="{StaticResource SubtitleTextBlockStyle}" />
      <TextBlock TextWrapping="Wrap"
                 Text="Файл .reg в формате «Windows Registry Editor Version 5.00». Без файла применяется проверочный маркер M1." />
      <Grid ColumnSpacing="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBox Header="Файл .reg" Text="{x:Bind ViewModel.RegFilePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <Button Grid.Column="1" Content="Выбрать..." VerticalAlignment="Bottom" Click="ChooseRegFile_Click" />
        <Button Grid.Column="2" Content="Убрать" VerticalAlignment="Bottom" Command="{x:Bind ViewModel.ClearRegFileCommand}"
                IsEnabled="{x:Bind ViewModel.HasRegFile, Mode=OneWay}" />
      </Grid>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <ComboBox Header="Кодировка" SelectedIndex="{x:Bind ViewModel.RegFileEncodingIndex, Mode=TwoWay}" MinWidth="160">
          <x:String>Авто (по BOM)</x:String>
          <x:String>UTF-16</x:String>
          <x:String>UTF-8</x:String>
          <x:String>ANSI</x:String>
        </ComboBox>
        <TextBox Header="Кодовая страница ANSI" Text="{x:Bind ViewModel.AnsiCodePage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 Width="180" IsEnabled="{x:Bind ViewModel.IsAnsi, Mode=OneWay}" />
      </StackPanel>

      <TextBlock Text="Превью операции" Style="{StaticResource SubtitleTextBlockStyle}" />
      <TextBlock Text="{x:Bind ViewModel.OperationPreview, Mode=OneWay}" IsTextSelectionEnabled="True" TextWrapping="Wrap" FontFamily="Consolas" />

      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Подключить движок" Command="{x:Bind ViewModel.ConnectEngineCommand}" />
        <Button Content="Подготовить" Command="{x:Bind ViewModel.PrepareCommand}" />
        <Button Content="Запустить" Command="{x:Bind ViewModel.StartCommand}" Style="{StaticResource AccentButtonStyle}" />
        <Button Content="Восстановить" Command="{x:Bind ViewModel.RecoverCommand}" />
      </StackPanel>

      <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
      <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" TextWrapping="Wrap" />
      <HyperlinkButton Content="{x:Bind ViewModel.PublishedPath, Mode=OneWay}" Command="{x:Bind ViewModel.OpenResultCommand}"
                       Visibility="{x:Bind ViewModel.HasResult, Mode=OneWay}" />
      <TextBox Header="Журнал" Text="{x:Bind ViewModel.Log, Mode=OneWay}" IsReadOnly="True"
               AcceptsReturn="True" TextWrapping="Wrap" MinHeight="200" FontFamily="Consolas" />
    </StackPanel>
  </ScrollViewer>
</Window>
