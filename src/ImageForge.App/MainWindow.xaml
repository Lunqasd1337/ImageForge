<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ImageForge.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="ImageForge">
  <ScrollViewer>
    <StackPanel Margin="24" Spacing="12" MaxWidth="900" HorizontalAlignment="Left">
      <TextBlock Text="ImageForge" Style="{StaticResource TitleTextBlockStyle}" />

      <TextBox Header="Источник (папка дистрибутива)" Text="{x:Bind ViewModel.SourcePath, Mode=TwoWay}" />
      <TextBox Header="Рабочая папка" Text="{x:Bind ViewModel.WorkPath, Mode=TwoWay}" />

      <TextBlock Text="Превью операции" Style="{StaticResource SubtitleTextBlockStyle}" />
      <TextBlock Text="{x:Bind ViewModel.OperationPreview}" IsTextSelectionEnabled="True" TextWrapping="Wrap" FontFamily="Consolas" />

      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Подключить движок" Command="{x:Bind ViewModel.ConnectEngineCommand}" />
        <Button Content="Запустить" IsEnabled="False" ToolTipService.ToolTip="Появится в M1" />
      </StackPanel>

      <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" TextWrapping="Wrap" />
      <TextBox Header="Журнал" Text="{x:Bind ViewModel.Log, Mode=OneWay}" IsReadOnly="True"
               AcceptsReturn="True" TextWrapping="Wrap" MinHeight="160" FontFamily="Consolas" />
    </StackPanel>
  </ScrollViewer>
</Window>
