<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ImageForge.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ImageForge.App"
    Title="ImageForge">
  <ScrollViewer>
    <StackPanel Margin="24" Spacing="12" MaxWidth="900" HorizontalAlignment="Left">
      <TextBlock Text="ImageForge" Style="{StaticResource TitleTextBlockStyle}" />

      <TextBox x:Uid="SourceBox" Text="{x:Bind ViewModel.SourcePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
      <TextBox x:Uid="WorkBox" Text="{x:Bind ViewModel.WorkPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
      <TextBox x:Uid="OutputBox" Text="{x:Bind ViewModel.OutputPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
      <TextBlock Text="{x:Bind ViewModel.FoldersWarning, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCautionBrush}"
                 Visibility="{x:Bind ViewModel.HasFoldersWarning, Mode=OneWay}" />
      <ComboBox x:Uid="EditionBox" ItemsSource="{x:Bind ViewModel.EditionNames}"
                SelectedIndex="{x:Bind ViewModel.EditionIndex, Mode=TwoWay}" MinWidth="360" />
      <TextBlock TextWrapping="Wrap" Text="{x:Bind ViewModel.EditionStatus, Mode=OneWay}" />

      <TextBlock x:Uid="RegistryTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
      <TextBlock x:Uid="RegistryHint" TextWrapping="Wrap" />
      <Grid ColumnSpacing="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBox x:Uid="RegFileBox" Text="{x:Bind ViewModel.RegFilePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <Button x:Uid="ChooseRegFile" Grid.Column="1" VerticalAlignment="Bottom" Click="ChooseRegFile_Click" />
        <Button x:Uid="ClearRegFile" Grid.Column="2" VerticalAlignment="Bottom" Command="{x:Bind ViewModel.ClearRegFileCommand}"
                IsEnabled="{x:Bind ViewModel.HasRegFile, Mode=OneWay}" />
      </Grid>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <ComboBox x:Uid="EncodingBox" SelectedIndex="{x:Bind ViewModel.RegFileEncodingIndex, Mode=TwoWay}" MinWidth="160">
          <ComboBoxItem x:Uid="EncodingAuto" />
          <ComboBoxItem x:Uid="EncodingUtf16" />
          <ComboBoxItem x:Uid="EncodingUtf8" />
          <ComboBoxItem x:Uid="EncodingAnsi" />
        </ComboBox>
        <TextBox x:Uid="AnsiCodePageBox" Text="{x:Bind ViewModel.AnsiCodePage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 Width="180" IsEnabled="{x:Bind ViewModel.IsAnsi, Mode=OneWay}" />
      </StackPanel>

      <TextBlock x:Uid="ImageTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button x:Uid="InspectButton" Command="{x:Bind ViewModel.InspectCommand}" />
      </StackPanel>

      <TextBlock x:Uid="AppsTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
      <TextBlock Text="{x:Bind ViewModel.AppsStatus, Mode=OneWay}" TextWrapping="Wrap" />
      <ItemsControl ItemsSource="{x:Bind ViewModel.Apps}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="local:AppxItem">
            <StackPanel Margin="0,2">
              <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" IsEnabled="{x:Bind CanSelect}">
                <StackPanel>
                  <TextBlock Text="{x:Bind Title}" />
                  <TextBlock Text="{x:Bind Details}" Style="{StaticResource CaptionTextBlockStyle}" IsTextSelectionEnabled="True" />
                  <TextBlock Text="{x:Bind Note}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                             Foreground="{ThemeResource SystemFillColorCautionBrush}" Visibility="{x:Bind HasNote}" />
                </StackPanel>
              </CheckBox>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock x:Uid="FeaturesTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
      <TextBlock Text="{x:Bind ViewModel.FeaturesStatus, Mode=OneWay}" TextWrapping="Wrap" />
      <Expander x:Uid="FeaturesExpander" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
        <ItemsControl ItemsSource="{x:Bind ViewModel.Features}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="local:FeatureItem">
              <StackPanel Margin="0,2">
                <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" IsEnabled="{x:Bind CanSelect}">
                  <StackPanel>
                    <TextBlock Text="{x:Bind Title}" />
                    <TextBlock Text="{x:Bind Details}" Style="{StaticResource CaptionTextBlockStyle}" IsTextSelectionEnabled="True" />
                    <TextBlock Text="{x:Bind Note}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                               Foreground="{ThemeResource SystemFillColorCautionBrush}" Visibility="{x:Bind HasNote}" />
                  </StackPanel>
                </CheckBox>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Expander>
      <CheckBox x:Uid="RemoveFeaturePayload" IsChecked="{x:Bind ViewModel.RemoveFeaturePayload, Mode=TwoWay}" />

      <TextBlock x:Uid="CapabilitiesTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
      <TextBlock Text="{x:Bind ViewModel.CapabilitiesStatus, Mode=OneWay}" TextWrapping="Wrap" />
      <Expander x:Uid="CapabilitiesExpander" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
        <ItemsControl ItemsSource="{x:Bind ViewModel.Capabilities}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="local:CapabilityItem">
              <StackPanel Margin="0,2">
                <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}">
                  <StackPanel>
                    <TextBlock Text="{x:Bind Title}" />
                    <TextBlock Text="{x:Bind Details}" Style="{StaticResource CaptionTextBlockStyle}" IsTextSelectionEnabled="True" />
                  </StackPanel>
                </CheckBox>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Expander>

      <TextBlock x:Uid="FodTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
      <TextBlock x:Uid="FodHint" TextWrapping="Wrap" />
      <Grid ColumnSpacing="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBox x:Uid="FodBox" Text="{x:Bind ViewModel.FodPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <Button x:Uid="ChooseFod" Grid.Column="1" VerticalAlignment="Bottom" Click="ChooseFodFolder_Click" />
      </Grid>
      <TextBlock Text="{x:Bind ViewModel.AvailableStatus, Mode=OneWay}" TextWrapping="Wrap" />
      <Expander x:Uid="AvailableExpander" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
        <StackPanel Spacing="8">
          <TextBox x:Uid="AvailableFilter"
                   Text="{x:Bind ViewModel.AvailableFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
          <ItemsControl ItemsSource="{x:Bind ViewModel.AvailableCapabilities}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="local:CapabilityItem">
                <StackPanel Margin="0,2">
                  <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}">
                    <StackPanel>
                      <TextBlock Text="{x:Bind Title}" />
                      <TextBlock Text="{x:Bind Details}" Style="{StaticResource CaptionTextBlockStyle}" IsTextSelectionEnabled="True" />
                    </StackPanel>
                  </CheckBox>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Expander>

      <TextBlock x:Uid="DriversTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
      <TextBlock Text="{x:Bind ViewModel.DriversStatus, Mode=OneWay}" TextWrapping="Wrap" />
      <Expander x:Uid="ImageDriversExpander" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
        <ItemsControl ItemsSource="{x:Bind ViewModel.ImageDrivers}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="local:InstalledDriverItem">
              <StackPanel Margin="0,2">
                <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}">
                  <StackPanel>
                    <TextBlock Text="{x:Bind Title}" />
                    <TextBlock Text="{x:Bind Details}" Style="{StaticResource CaptionTextBlockStyle}" IsTextSelectionEnabled="True" />
                    <TextBlock Text="{x:Bind Note}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                               Foreground="{ThemeResource SystemFillColorCautionBrush}" Visibility="{x:Bind HasNote}" />
                  </StackPanel>
                </CheckBox>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Expander>
      <CheckBox x:Uid="AllowBootCritical"
                IsChecked="{x:Bind ViewModel.AllowBootCritical, Mode=TwoWay}" />

      <TextBlock x:Uid="DriverFolderTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
      <TextBlock x:Uid="DriverFolderHint" TextWrapping="Wrap" />
      <Grid ColumnSpacing="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBox x:Uid="DriverFolderBox" Text="{x:Bind ViewModel.DriverPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <Button x:Uid="ChooseDriverFolder" Grid.Column="1" VerticalAlignment="Bottom" Click="ChooseDriverFolder_Click" />
        <Button x:Uid="ScanDrivers" Grid.Column="2" VerticalAlignment="Bottom" Command="{x:Bind ViewModel.ScanDriversCommand}" />
      </Grid>
      <TextBlock Text="{x:Bind ViewModel.DriverPackagesStatus, Mode=OneWay}" TextWrapping="Wrap" />
      <Expander x:Uid="DriverPackagesExpander" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
        <ItemsControl ItemsSource="{x:Bind ViewModel.DriverPackages}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="local:DriverPackageItem">
              <StackPanel Margin="0,2">
                <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" IsEnabled="{x:Bind CanSelect}">
                  <StackPanel>
                    <TextBlock Text="{x:Bind Title}" />
                    <TextBlock Text="{x:Bind Details}" Style="{StaticResource CaptionTextBlockStyle}" IsTextSelectionEnabled="True" />
                    <TextBlock Text="{x:Bind Note}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                               Foreground="{ThemeResource SystemFillColorCautionBrush}" Visibility="{x:Bind HasNote}" />
                  </StackPanel>
                </CheckBox>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Expander>
      <CheckBox x:Uid="ForceUnsigned"
                IsChecked="{x:Bind ViewModel.ForceUnsigned, Mode=TwoWay}" />

      <TextBlock x:Uid="UpdatesTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
      <TextBlock Text="{x:Bind ViewModel.UpdatesStatus, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
      <TextBlock x:Uid="UpdatesHint" TextWrapping="Wrap" />
      <Grid ColumnSpacing="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBox x:Uid="UpdateFolderBox" Text="{x:Bind ViewModel.UpdatePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <Button x:Uid="ChooseUpdateFolder" Grid.Column="1" VerticalAlignment="Bottom" Click="ChooseUpdateFolder_Click" />
        <Button x:Uid="ScanUpdates" Grid.Column="2" VerticalAlignment="Bottom" Command="{x:Bind ViewModel.ScanUpdatesCommand}" />
      </Grid>
      <TextBlock Text="{x:Bind ViewModel.UpdatePackagesStatus, Mode=OneWay}" TextWrapping="Wrap" />
      <Expander x:Uid="UpdatePackagesExpander" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
        <ItemsControl ItemsSource="{x:Bind ViewModel.UpdatePackages}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="local:UpdatePackageItem">
              <StackPanel Margin="0,2">
                <TextBlock Text="{x:Bind Title}" />
                <TextBlock Text="{x:Bind Details}" Style="{StaticResource CaptionTextBlockStyle}" IsTextSelectionEnabled="True" />
                <TextBlock Text="{x:Bind Note}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                           Foreground="{ThemeResource SystemFillColorCautionBrush}" Visibility="{x:Bind HasNote}" />
                <StackPanel Orientation="Horizontal" Spacing="16">
                  <CheckBox x:Uid="UpdateToImage" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" IsEnabled="{x:Bind CanSelect}" />
                  <CheckBox x:Uid="UpdateToWinRe" IsChecked="{x:Bind IsForWinRe, Mode=TwoWay}" IsEnabled="{x:Bind CanSelect}" />
                  <CheckBox x:Uid="UpdateToBoot" IsChecked="{x:Bind IsForBoot, Mode=TwoWay}" IsEnabled="{x:Bind CanSelect}" />
                </StackPanel>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Expander>

      <CheckBox x:Uid="CleanupComponents"
                IsChecked="{x:Bind ViewModel.CleanupComponents, Mode=TwoWay}" />
      <CheckBox x:Uid="ResetBase"
                IsChecked="{x:Bind ViewModel.ResetBase, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.CleanupComponents, Mode=OneWay}" Margin="28,0,0,0" />

      <TextBlock x:Uid="PreviewTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
      <TextBlock Text="{x:Bind ViewModel.OperationPreview, Mode=OneWay}" IsTextSelectionEnabled="True" TextWrapping="Wrap" FontFamily="Consolas" />

      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button x:Uid="ConnectEngine" Command="{x:Bind ViewModel.ConnectEngineCommand}" />
        <Button x:Uid="PrepareButton" Command="{x:Bind ViewModel.PrepareCommand}" />
        <Button x:Uid="StartButton" Command="{x:Bind ViewModel.StartCommand}" Style="{StaticResource AccentButtonStyle}" />
        <Button x:Uid="RecoverButton" Command="{x:Bind ViewModel.RecoverCommand}" />
      </StackPanel>

      <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
      <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" TextWrapping="Wrap" />
      <HyperlinkButton Content="{x:Bind ViewModel.PublishedPath, Mode=OneWay}" Command="{x:Bind ViewModel.OpenResultCommand}"
                       Visibility="{x:Bind ViewModel.HasResult, Mode=OneWay}" />
      <TextBox x:Uid="LogBox" Text="{x:Bind ViewModel.Log, Mode=OneWay}" IsReadOnly="True"
               AcceptsReturn="True" TextWrapping="Wrap" MinHeight="200" FontFamily="Consolas" />
    </StackPanel>
  </ScrollViewer>
</Window>
